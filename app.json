{
  "expo": {
    "name": "FinQuest",
    "slug": "finquest",
    "scheme": "finquest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f0b1e",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.finquest.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0b1e"
      }
    },
    "ios": {
      "bundleIdentifier": "com.finquest.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f0b1e"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# expo-gl creates GLView by reflection and ships no keep rule; R8 strips its constructor and the app crashes on launch.\n-keep class expo.modules.gl.** { *; }"
          }
        }
      ]
    ]
  }
}
